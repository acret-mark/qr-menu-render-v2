# Render Postgres connection string (vanilla Postgres — no `auth` schema).
DATABASE_URL=postgres://user:password@host:5432/hapag

# Auth.js v5 session/JWT signing secret. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Cloudinary (image CDN) — unchanged by the Render/Auth.js migration.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Gmail SMTP via nodemailer (transactional email) — unchanged by the migration.
GMAIL_SMTP_USER=
GMAIL_SMTP_APP_PASSWORD=

# AI Description Assist — Gemini primary, Claude fallback.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Instant Translate.
DEEPL_API_KEY=

# Bearer token required by the cron routes (payment-reminders, subscription-expiry).
CRON_SECRET=

# Used to build absolute links in emails and the cron job's own request.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional — daily AI-description generation cap and pending-payment reminder
# threshold; both fall back to sane defaults in code if unset.
# AI_DESCRIPTION_DAILY_LIMIT=10
# PAYMENT_REMINDER_THRESHOLD_DAYS=3
